PORT=3001
NODE_ENV=development
# PostgreSQL is used when DATABASE_URL is set. Run schema.sql once before startup.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/le_meilleur_prix
# Use a unique random secret of at least 32 bytes in production.
JWT_SECRET=replace-this-with-a-long-random-secret
# Comma-separated exact browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5173
# Set PGSSL=true when your managed PostgreSQL requires TLS.
PGSSL=false
